# Copy to .env for local development. Every value has a sensible default.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=true

# Optional: OpenRouteService key enables the truck (driving-hgv) profile and
# native 3-alternative routing. Without it the public OSRM server is used.
ORS_API_KEY=

# Weather: auto | open-meteo | metno. auto switches to MET Norway while
# Open-Meteo reports its per-IP quota is exhausted.
WEATHER_PROVIDER=auto

# Tuning
WEATHER_CACHE_SECONDS=900
UPSTREAM_TIMEOUT_SECONDS=25
API_THROTTLE_RATE=60/min
